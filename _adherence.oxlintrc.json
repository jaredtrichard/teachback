{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|DM Sans|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Sora, DM Sans, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|ghost|fullWidth|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, ghost, fullWidth, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|info|danger|star|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'info' | 'danger' | 'star' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:sunken|accent|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: sunken, accent, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:primary|accent|info|star|danger|mastered)$/]",
        "message": "<Card> accent must be one of 'primary' | 'accent' | 'info' | 'star' | 'danger' | 'mastered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CriterionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|feedback|outcome|style|key|ref|className|style|children)$/]",
        "message": "<CriterionRow> doesn't accept that prop. Declared props: label, feedback, outcome, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CriterionRow'] > JSXAttribute[name.name='outcome'] > Literal[value!=/^(?:hit|partial|missing|wrong|hedged)$/]",
        "message": "<CriterionRow> outcome must be one of 'hit' | 'partial' | 'missing' | 'wrong' | 'hedged'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|primary)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|color|height|label|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, color, height, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|accent|star|info|mastered)$/]",
        "message": "<ProgressBar> color must be one of 'primary' | 'accent' | 'star' | 'info' | 'mastered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|message|style|key|ref|className|style|children)$/]",
        "message": "<ResultBanner> doesn't accept that prop. Declared props: state, message, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultBanner'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:Unassessed|Gap|Misconception|Rusty|Exam-Ready|Mastered)$/]",
        "message": "<ResultBanner> state must be one of 'Unassessed' | 'Gap' | 'Misconception' | 'Rusty' | 'Exam-Ready' | 'Mastered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|style|key|ref|className|style|children)$/]",
        "message": "<StateBadge> doesn't accept that prop. Declared props: state, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:Unassessed|Gap|Misconception|Rusty|Exam-Ready|Mastered)$/]",
        "message": "<StateBadge> state must be one of 'Unassessed' | 'Gap' | 'Misconception' | 'Rusty' | 'Exam-Ready' | 'Mastered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StateBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|style|key|ref|className|style|children)$/]",
        "message": "<StreakBadge> doesn't accept that prop. Declared props: count, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeachBackBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|prompt|placeholder|minChars|rows|style|key|ref|className|style|children)$/]",
        "message": "<TeachBackBox> doesn't accept that prop. Declared props: value, onChange, prompt, placeholder, minChars, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|state|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TopicChip> doesn't accept that prop. Declared props: id, title, state, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:Unassessed|Gap|Misconception|Rusty|Exam-Ready|Mastered)$/]",
        "message": "<TopicChip> state must be one of 'Unassessed' | 'Gap' | 'Misconception' | 'Rusty' | 'Exam-Ready' | 'Mastered'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
